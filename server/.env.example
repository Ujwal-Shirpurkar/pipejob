# ── AI ────────────────────────────────────────────────────────────────────────
# Required for evaluation, tailoring and the agent. Everything else works without it.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max — higher = more thorough, slower, more tokens
AGENT_EFFORT=
EVAL_EFFORT=

# ── Agent guardrails (per run) ────────────────────────────────────────────────
AGENT_MAX_TURNS=30
AGENT_MAX_EVALUATIONS=12
AGENT_MAX_TAILORED=3

# ── Files & storage (relative to server/) ─────────────────────────────────────
MASTER_CV_PATH=../master-cv.json
PREFERENCES_PATH=../preferences.json
PORTALS_PATH=../portals.json
OUTPUT_DIR=./outputs
LOG_DIR=./logs
DB_PATH=./data/applications.sqlite

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_JOBS_PER_SEARCH=40
# Self-imposed daily budget for recorded applications
MAX_APPLICATIONS_PER_DAY=5

# ── Automation (optional) ─────────────────────────────────────────────────────
# Cron for autopilot runs, e.g. "0 8 * * 1-5" (weekdays 08:00). Empty = off.
AUTOPILOT_CRON=
# Enables /api/webhooks/* for n8n; sent as the X-Webhook-Secret header
WEBHOOK_SECRET=
# Telegram notifications when the agent shortlists a job
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ── AI Coding Assistants (Local Workspace Config) ─────────────────────────────
# Set these if you use AI coding agents to work on this repository

# Claude Code
# (Uses ANTHROPIC_API_KEY from the top of this file)
ANTHROPIC_BASE_URL=

# Codex / OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Google Antigravity
GEMINI_API_KEY=
GEMINI_MODEL=
